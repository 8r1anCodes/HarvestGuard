    "waterlogging": {
      "title": "Waterlogging",
      "inspect": ["Standing water between rows", "Yellowing lower leaves", "Soft or discoloured roots and stem bases"],
      "actions": ["Dig drainage channels along the low side of the field", "Avoid walking or working the field while it is wet", "Delay top-dressing fertiliser until water drains", "Ridge or mound rows if replanting is later needed"]
    },
    "drought": {
      "title": "Dry spell",
      "inspect": ["Leaf rolling or wilting in the afternoon", "Soil dryness 10 cm below the surface", "Stunted growth compared with neighbours"],
      "actions": ["Water in the early morning or evening if you have a source", "Mulch with crop residue or dry grass", "Control weeds that compete for water", "Postpone planting or top-dressing until rain returns"]
    },
    "heat": {
      "title": "Heat stress",
      "inspect": ["Flower or fruit drop", "Scorched leaf edges", "Wilting during the hottest hours"],
      "actions": ["Irrigate in the cool of the day", "Mulch to keep roots cooler", "Harvest early in the morning", "Provide shade for seedlings or nurseries if possible"]
    }
  },
